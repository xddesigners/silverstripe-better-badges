{
    "name": "xddesigners/silverstripe-better-badges",
    "description": "Stop CMS page-tree status/locale badges from merging into one solid vertical bar. Adds spacing and a choice of styles (outline, compact, pill) via config.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "cms",
        "badges",
        "sitetree",
        "ux",
        "admin",
        "fluent"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Remy Vaartjes",
            "email": "remy@xd.nl"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/admin": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "XD\\BetterBadges\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "expose": [
            "client"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
